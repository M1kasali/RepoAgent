  "api_compatibility_patches": [
    {
      "local": "repoagent/boxlite_sandbox/boxlite_executor.py",
      "old": "            # boxlite 0.8.2 \u4e2d network \u662f\u5b57\u7b26\u4e32\u5b57\u6bb5\uff0callow_net \u662f\u72ec\u7acb\u7684\u5217\u8868\u5b57\u6bb5\uff1b\n            # \u8be5\u7248\u672c\u4e0d\u5b58\u5728 NetworkSpec\n            extra_kwargs: dict = {}\n            if self._allow_net is False:\n                extra_kwargs[\"network\"] = \"none\"\n            elif isinstance(self._allow_net, list):\n                extra_kwargs[\"allow_net\"] = self._allow_net\n",
      "new": "            # The reference pins 0.9.5 but used the older network keywords.\n            # Preserve its policy using the pinned SDK's NetworkSpec API.\n            extra_kwargs: dict = {}\n            if self._allow_net is False:\n                extra_kwargs[\"network\"] = boxlite.NetworkSpec(mode=\"disabled\")\n            elif isinstance(self._allow_net, list):\n                extra_kwargs[\"network\"] = boxlite.NetworkSpec(mode=\"enabled\", allow_net=self._allow_net)\n",
      "reason": "Pinned BoxLite 0.9.5 requires NetworkSpec; older reference keywords raise TypeError.",
      "sdk_reference": "https://pypi.org/project/boxlite/0.9.5/"
    }
  ]
