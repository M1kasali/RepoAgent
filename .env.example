# Copy this file to .env and fill only the providers you use.

# Optional provider selector. CLI --provider still takes precedence.
REPOAGENT_PROVIDER=deepseek

# Recommended default. DeepSeek uses its Anthropic-compatible endpoint.
REPOAGENT_DEEPSEEK_API_BASE=https://api.deepseek.com/anthropic
REPOAGENT_DEEPSEEK_API_KEY=
REPOAGENT_DEEPSEEK_MODEL=deepseek-v4-pro

# Optional right.codes shared key. Used by --provider openai and --provider anthropic when provider-specific keys are empty.
REPOAGENT_RIGHT_CODES_API_KEY=

# Default OpenAI-compatible endpoint. Change this if you use another /responses-compatible service.
REPOAGENT_OPENAI_API_BASE=https://www.right.codes/codex/v1
REPOAGENT_OPENAI_API_KEY=
REPOAGENT_OPENAI_MODEL=gpt-5.4

# Default Anthropic-compatible endpoint. Can reuse REPOAGENT_RIGHT_CODES_API_KEY when your gateway shares one key.
REPOAGENT_ANTHROPIC_API_BASE=https://www.right.codes/claude/v1
REPOAGENT_ANTHROPIC_API_KEY=
REPOAGENT_ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional comma-separated extra env names to redact from traces and reports.
REPOAGENT_SECRET_ENV_NAMES=
